# Port the Go server listens on (Render sets this automatically).
PORT=8080

# Base URL phones should open when scanning the QR code. Leave empty to use the
# presenter's own address. Set it to an HTTPS tunnel URL in development, e.g.
# PUBLIC_URL=https://example.trycloudflare.com
PUBLIC_URL=

# Extra Origin hosts allowed to open the WebSocket (comma-separated, glob
# patterns). Same-origin is always allowed.
ALLOWED_ORIGINS=

# STUN/TURN servers for the phone <-> laptop WebRTC link (JSON).
ICE_SERVERS=[{"urls":["stun:stun.l.google.com:19302","stun:stun1.l.google.com:19302"]}]

# Path to LibreOffice's soffice binary for PPTX conversion (auto-detected).
SOFFICE_PATH=
